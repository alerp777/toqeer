# ============================================================================
# AJKMart Super App — COMPLETE Environment Variables Template (All 5 Apps)
# ============================================================================
# 
# FILE: .env.all  (Root directory mein rakhein)
#
# YE TEMPLATE 5 apps ke liye complete env vars cover karta hai:
#   1. API Server (Express)    → No prefix vars (e.g., JWT_SECRET)
#   2. Admin Panel (Vite)      → VITE_* prefix vars
#   3. Vendor App (Vite)       → VITE_* prefix vars
#   4. Rider App (Vite)       → VITE_* prefix vars
#   5. Customer App (Expo)     → EXPO_PUBLIC_* prefix vars
#
# ---------------------------------------------------------------------------
# REPLIT DEPLOYMENT (Recommended):
#   → Sab secrets ko Replit Secrets panel mein add karein (left sidebar)
#   → Vite apps ko VITE_ prefix wale vars sirf build time pe milte hain
#   → Expo ko EXPO_PUBLIC_ prefix wale vars sirf build time pe milte hain
#   → API server ko normal vars milte hain
#
# LOCAL / VPS DEPLOYMENT:
#   1. cp .env.all .env
#   2. Sab values fill karein
#   3. pnpm install && pnpm dev
#
# HOW TO GENERATE SECRETS:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================================================

# =============================================================================
# SECTION 1: API SERVER — CRITICAL VARS (No Prefix)
# =============================================================================
# Ye vars API server ke liye hain. Replit Secrets mein "Secret" type mein add karein.

# ── DATABASE (REQUIRED) ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
DB_POOL_MAX=25

# ── AUTH SECRETS (REQUIRED) ────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_ISSUER=ajkmart
TOKEN_HASH_SECRET=
ENCRYPTION_MASTER_KEY=

# ── ADMIN AUTH SECRETS (REQUIRED) ────────────────────────────────────────────────────────────
ADMIN_ACCESS_TOKEN_SECRET=
ADMIN_REFRESH_TOKEN_SECRET=
ADMIN_CSRF_SECRET=
ERROR_REPORT_HMAC_SECRET=

# ── ADMIN SEED — First super-admin account (REQUIRED for first run) ──────────────────────
ADMIN_SEED_PASSWORD=Admin@123
ADMIN_SEED_USERNAME=superadmin
ADMIN_SEED_EMAIL=admin@ajkmart.com
ADMIN_SEED_NAME=Super Admin

# ── DEV / STAGING FLAGS ─────────────────────────────────────────────────────────────────
NODE_ENV=development
# Sirf dev mein true — OTP API response mein show hoga
ALLOW_DEV_OTP=true
# Dev seed route enable karne ke liye (production mein block hota hai)
ALLOW_DEV_SEED=true
# Dev seed key — seed API call mein x-admin-seed-key header mein bhejein
ADMIN_SEED_KEY=your-secret-seed-key-123

# ── LOGGING ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── REDIS — Rate limiting, JWT blacklist, sessions (OPTIONAL but recommended) ─────────────
REDIS_URL=
# Free Redis: https://upstash.com
# Format: redis://default:password@host:port or rediss:// for TLS

# ── FILE STORAGE — Uploads, avatars, KYC docs (OPTIONAL) ───────────────────────────────────
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET_NAME=
STORAGE_REGION=us-east-1
# Use: DigitalOcean Spaces, Cloudflare R2, AWS S3, Backblaze B2

# ── SMS / Twilio — OTP delivery (OPTIONAL) ─────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── EMAIL / SendGrid — Verification, magic links (OPTIONAL) ──────────────────────────────────
SENDGRID_API_KEY=
SMTP_HOST=smtp.sendgrid.net

# ── FIREBASE — Push notifications, analytics (OPTIONAL) ────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── AI / Gemini — Chatbot, support (OPTIONAL) ────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── MAPS — Geocoding, routing (OPTIONAL) ───────────────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
OSRM_API_URL=https://router.project-osrm.org

# ── ERROR TRACKING / Sentry (OPTIONAL) ───────────────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_WEBHOOK_SECRET=
SENTRY_SAMPLE_RATE=0.2

# ── WEB PUSH / VAPID (OPTIONAL) ───────────────────────────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@ajkmart.app

# ── CORS / SOCKET.IO ─────────────────────────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=
ALLOWED_DOMAINS=

# ── PRODUCTION URLS ────────────────────────────────────────────────────────────────────────────────────────────────
APP_BASE_URL=https://yourapp.replit.app
ADMIN_BASE_URL=https://yourapp.replit.app/admin
FRONTEND_URL=https://yourapp.replit.app

# ── ERROR REPORTING ──────────────────────────────────────────────────────────────────────────────────────────────────
ERROR_REPORT_RATE_PER_MIN=30

# ── ADMIN PASSWORD RESET ────────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD_RESET_TOKEN_TTL_MIN=30

# ── RIDER / VENDOR JWT (alag alag app ke liye) ───────────────────────────────────────────────────────────────
# Agar alag alag JWT secrets chahiye rider/vendor ke liye:
RIDER_JWT_SECRET=
VENDOR_JWT_SECRET=

# ── HMAC OTP SECRETS (NEW — production ke liye zaroori) ────────────────────────────────────────────────────────────
HMAC_OTP_SECRET=
OTP_HMAC_SECRET=


# =============================================================================
# SECTION 2: ADMIN PANEL — VITE_* Prefix (Build Time Only)
# =============================================================================
# Ye vars sirf Admin Panel ke liye hain. Vite build time pe inject hote hain.
# Replit Secrets mein add karein (Vite .env mein automatically pick karta hai)
# Ya .env.admin file bana kar root mein rakhein

# ── API Connection ───────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Empty = same origin (Replit reverse proxy). Alag domain pe ho to URL set karein
VITE_API_BASE_URL=
# Dev proxy target (sirf local dev ke liye)
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# ── Sentry (OPTIONAL) ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Web Push (OPTIONAL) ────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_VAPID_PUBLIC_KEY=

# ── Dev Tools ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# Bundle analyzer chalane ke liye: ANALYZE=1 pnpm build
ANALYZE=0


# =============================================================================
# SECTION 3: VENDOR APP — VITE_* Prefix (Build Time Only)
# =============================================================================
# Ye vars sirf Vendor App ke liye hain. Same pattern as Admin panel.

# ── API Connection ────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# ── Capacitor Native Build ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
# "true" jab native iOS/Android build ho
VITE_CAPACITOR=false

# ── Sentry (OPTIONAL) ─────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Firebase Push (OPTIONAL) ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── TURN Server — WebRTC Video Calls (OPTIONAL) ───────────────────────────────────────────────────────────────────────────────────────────────────
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=


# =============================================================================
# SECTION 4: RIDER APP — VITE_* Prefix (Build Time Only)
# =============================================================================
# Ye vars sirf Rider App ke liye hain. Same pattern as Vendor app.

# ── API Connection ────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# ── Capacitor Native Build ───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_CAPACITOR=false

# ── Sentry (OPTIONAL) ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_SENTRY_DSN=

# ── Firebase Push (OPTIONAL) ──────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# =============================================================================
# SECTION 5: CUSTOMER APP (Expo) — EXPO_PUBLIC_* Prefix (Build Time Only)
# =============================================================================
# Ye vars sirf Expo (React Native) customer app ke liye hain.
# Expo build time pe EXPO_PUBLIC_ prefix wale vars ko bundle mein inject karta hai.

# ── Domain / API Origin ───────────────────0───────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────────