# ============================================================
#  AJKMart - Environment Variables Template
#  Copy this file to .env and fill in your values
#  cp .env.example .env
# ============================================================

# ------------------------------------------------------------
# DATABASE (Required)
# ------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_8CZnNQxSivM4@ep-hidden-salad-aoxle3sz-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ------------------------------------------------------------
# API SERVER
# ------------------------------------------------------------
PORT=3000
NODE_ENV=production
APP_BASE_URL=http://localhost:3000

# Generate with: openssl rand -hex 32
JWT_SECRET=change_this_to_a_very_strong_random_secret_at_least_32_chars
ADMIN_SECRET=change_this_to_a_strong_random_secret
TOTP_ENCRYPTION_KEY=change_this_to_a_32_byte_base64_or_hex_secret

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------------
# FRONTEND / WEB APPS (Vite)
# ------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000

# Set to "true" when building for native Android/iOS with Capacitor
VITE_CAPACITOR=false

# ------------------------------------------------------------
# MOBILE APP (Expo)
# ------------------------------------------------------------
EXPO_PUBLIC_DOMAIN=http://localhost:3000
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here
EXPO_PUBLIC_FB_APP_ID=your_facebook_app_id_here

# ------------------------------------------------------------
# SMS / OTP
# ------------------------------------------------------------
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# MSG91_API_KEY=your_msg91_api_key

# ------------------------------------------------------------
# EMAIL
# ------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=AJKMart <noreply@ajkmart.com>

# ------------------------------------------------------------
# WEB PUSH NOTIFICATIONS
# ------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:admin@yourdomain.com

# ------------------------------------------------------------
# WEBHOOKS
# ------------------------------------------------------------
WHATSAPP_APP_SECRET=your_whatsapp_app_secret

# ------------------------------------------------------------
# AI / OPENAI
# ------------------------------------------------------------
# OPENAI_API_KEY=sk-your_openai_api_key_here
