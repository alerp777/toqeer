# .env.capacitor — Copy to .env.capacitor.local and fill in values.
# Used by: pnpm --filter @workspace/rider-app build:cap
# (BASE_PATH=/ and VITE_CAPACITOR=true are set automatically by the build:cap script)

# Required: absolute URL of your deployed API server.
# The native WebView cannot use the Vite dev-proxy, so this must be a real URL.
VITE_API_BASE_URL=https://api.ajkmart.com

# Firebase Cloud Messaging (optional — push notifications will be disabled without it)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
